# =============================================
# VARIABLES DE ENTORNO - Puesto de Chance API
# Copie este archivo como .env y ajuste los valores
# =============================================

# Puerto en el que escucha el servidor
PORT=3000

# Secreto para firmar los tokens JWT (use una cadena aleatoria larga en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion

# Duración del token JWT (ej: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Zona horaria para cálculos de fecha local (formato IANA)
ZONA_HORARIA=America/Bogota

# Minutos máximos para anular un tiquete después de la venta
MINUTOS_ANULACION=10

# Minutos antes del sorteo en que se cierran las ventas
MINUTOS_CIERRE_VENTAS=15

# Valor mínimo permitido por apuesta de chance (en pesos)
APUESTA_MIN_CHANCE=500

# Valor máximo permitido por apuesta de chance (en pesos)
APUESTA_MAX_CHANCE=50000

# Precio fijo por jugada de Baloto (en pesos)
VALOR_BALOTO=5700

# Días de vigencia para reclamar un premio
DIAS_CADUCIDAD_PREMIO=365
